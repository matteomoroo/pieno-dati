@@ -71,20 +77,58 @@ jobs:
           node-version: '22'
           cache: npm
 
-      - run: npm ci
+      - name: Installazione pulita
+        run: npm ci
+
+      # La versione di Playwright determina quella dei browser: la usiamo come
+      # chiave di cache, così i browser si riscaricano solo quando Playwright
+      # cambia versione, non a ogni run.
+      - name: Versione di Playwright
+        id: pw
+        run: echo "version=$(node -p "require('@playwright/test/package.json').version")" >> "$GITHUB_OUTPUT"
 
-      - name: Installa i browser Playwright
+      - name: Cache dei browser Playwright
+        id: pw-cache
+        uses: actions/cache@v4
+        with:
+          path: ~/.cache/ms-playwright
+          key: playwright-${{ runner.os }}-${{ steps.pw.outputs.version }}
+
+      # Se la cache ha centrato, i binari dei browser ci sono già: installiamo
+      # solo le dipendenze di sistema (--only-shell è sufficiente per Chromium
+      # headless e non riscarica il browser). Su cache mancante, installazione
+      # completa. In entrambi i casi il browser non viene scaricato due volte.
+      - name: Installa Chromium (cache mancante)
+        if: steps.pw-cache.outputs.cache-hit != 'true'
         run: npx playwright install --with-deps chromium
 
+      - name: Dipendenze di sistema (cache presente)
+        if: steps.pw-cache.outputs.cache-hit == 'true'
+        run: npx playwright install-deps chromium
+
       - name: Build
         run: npm run build:preview
 
       - name: Test end-to-end
         run: npm run test:e2e
 
-      - uses: actions/upload-artifact@v4
-        if: failure()
+      # Il report HTML si carica sempre, verde o rosso: serve anche per leggere
+      # il conteggio di passati/falliti/skip di una run riuscita.
+      - name: Report HTML Playwright
+        if: ${{ !cancelled() }}
+        uses: actions/upload-artifact@v4
         with:
           name: playwright-report
           path: playwright-report/
-          retention-days: 7
+          retention-days: 14
+
+      # test-results/ contiene screenshot, video e trace dei soli test falliti.
+      # Vuoto quando tutto passa, quindi lo carichiamo solo sui fallimenti.
+      - name: Screenshot, video e trace dei fallimenti
+        if: failure()
+        uses: actions/upload-artifact@v4
+        with:
+          name: playwright-failures
+          path: test-results/
+          retention-days: 14
+          if-no-files-found: ignore
