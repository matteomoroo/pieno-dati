{
  "name": "pieno-dati",
  "version": "2.0.0",
  "description": "Ingest giornaliero degli open data MIMIT sui prezzi carburante. Pipeline tipizzata (schema v2) che genera stations.json, meta.json, history.json, status.json serviti da GitHub Pages.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "astro dev",
    "data": "node --experimental-strip-types scripts/build.ts",
    "build": "astro build",
    "build:preview": "SITE_URL=https://matteomoroo.github.io BASE_PATH=/pieno-dati/ astro build",
    "build:root": "SITE_URL=https://pieno.example BASE_PATH=/ astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run smoke"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.9.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.4",
    "wrangler": "^4.125.0"
  },
  "dependencies": {
    "astro": "^4.16.19",
    "maplibre-gl": "^4.7.1"
  }
}
