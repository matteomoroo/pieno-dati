# Configurazione di build. Copiare in .env per lo sviluppo locale.
# In CI questi valori arrivano dalle Repository Variables (vedi docs/deploy.md).

# Origin pubblico, senza barra finale.
SITE_URL=https://matteomoroo.github.io

# Base path. "/pieno-dati/" per GitHub Pages, "/" per il dominio definitivo.
BASE_PATH=/pieno-dati/

# Identificativo di build per la cache del service worker.
# In CI viene impostato al commit SHA; in locale è generato automaticamente.
# BUILD_ID=
