---
/**
 * Homepage di benzaGo.
 * Legge i numeri reali da meta.json (build-time), mostra il totem prezzo,
 * la barra di ricerca, il selettore carburante e la mappa interattiva.
 * Distinta dalla mappa a schermo intero (/mappa): qui c'è anche contenuto
 * testuale indicizzabile.
 */
import Base from '../layouts/Base.astro';
import MapView from '../components/map/MapView.astro';
import Wordmark from '../components/brand/Wordmark.astro';
import {
  loadMeta,
  formatDate,
  freshnessLabel,
  FUEL_DISPLAY_ORDER,
  FUEL_UI_LABELS,
} from '../lib/data/load.ts';
import { getTerritory } from '../lib/geo/loadTerritory.ts';
import { BASE } from '../lib/site.ts';
import {
  buildAverageTable,
  averageFor,
  averageLabel,
  formatAverage,
  SELF_UNAVAILABLE,
} from '../lib/data/nationalAverage.ts';

const meta = loadMeta();
// Medie nazionali di TUTTI i carburanti, dalla stessa fonte della pipeline
// (meta.stats). Il carburante iniziale è il primo chip; gli altri vengono
// letti dal browser quando l'utente cambia carburante.
const initialFuel = FUEL_DISPLAY_ORDER[0];
const averages = buildAverageTable(meta?.stats, FUEL_DISPLAY_ORDER);
const initialAverage = averageFor(averages, initialFuel);
const total = meta?.total ?? 0;
const extractionDate = meta?.sourceExtractionDate
  ? formatDate(meta.sourceExtractionDate)
  : '';

// Regioni per i link SEO nel footer (Google segue i link per scoprire le pagine).
// Stato di freschezza del dataset: va comunicato sempre, e quando i dati non
// sono recenti l'avviso deve essere esplicito.
const freshnessStatus = meta?.freshness?.status ?? 'unknown';
const regions = getTerritory();
const baseUrl = BASE;
---

<Base
  title="benzaGo — Prezzi carburante in Italia, aggiornati ogni giorno"
  description="Confronta i prezzi di benzina, diesel, GPL e metano dei distributori in Italia. Dati ufficiali del Ministero, aggiornati ogni mattina."
>
  <header class="hero">
    <div class="hero-bar">
      <div class="brand">
        <img
          class="brand-mark"
          src={`${baseUrl}/brand/logo-symbol-light.png`}
          alt=""
          aria-hidden="true"
          width="34"
          height="34"
          decoding="async"
        />
        <Wordmark tone="dark" class="brand-name" />
      </div>
      <nav class="hero-nav" aria-label="Strumenti">
        <a href={`${baseUrl}/calcola-risparmio`}>Calcola il risparmio</a>
        <a href={`${baseUrl}/andamento-prezzi`}>Andamento prezzi</a>
      </nav>
    </div>
    <div class="hero-text">
      <h1>Dove conviene fare il pieno oggi</h1>
      <p class="tagline">
        Prezzi ufficiali MIMIT di {total.toLocaleString('it-IT')} distributori in Italia.
      </p>
    </div>
  </header>

  <main class="container" id="contenuto">
   <div class="home-grid">
    <div class="home-controls">
    <!-- 1. Posizione: prima azione. Il permesso viene chiesto SOLO al click. -->
    <div class="locate-block">
      <button id="locate" class="locate-cta" type="button" aria-describedby="locate-status">
        <svg class="locate-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
          <path
            fill="currentColor"
            d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"
          ></path>
        </svg>
        Trova distributori vicino a me
      </button>
      <p id="locate-status" class="locate-status" role="status" aria-live="polite"></p>
    </div>

    <p class="or-sep"><span>oppure</span></p>

    <form class="search" role="search" onsubmit="return false;">
      <label class="sr-only" for="q">Cerca città o comune</label>
      <span class="search-icon" aria-hidden="true">⌕</span>
      <input
        id="q"
        type="search"
        placeholder="Cerca città o comune"
        autocomplete="off"
      />
    </form>

    <!-- 2. Carburante: tutti visibili, vanno a capo invece di scorrere. -->
    <p class="control-label" id="fuel-label">Carburante</p>
    <div class="fuels" role="tablist" aria-labelledby="fuel-label">
      {
        FUEL_DISPLAY_ORDER.map((fuel, i) => (
          <button
            class:list={['fuel-chip', { active: i === 0 }]}
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-fuel={fuel}
          >
            {FUEL_UI_LABELS[fuel]}
          </button>
        ))
      }
    </div>

    <!-- 3. Filtri avanzati: secondari, mai aperti in automatico. -->
    <button id="filters-trigger" class="filters-trigger" type="button" aria-haspopup="dialog">
      <span aria-hidden="true">⚙</span>
      <span>Altri filtri</span><span id="filters-badge" class="filters-trigger-badge" hidden></span>
    </button>

    <!-- 4. Dato riassuntivo: segue sempre il carburante selezionato. -->
    <section
      class="totem"
      id="national-average"
      aria-labelledby="totem-label"
      aria-live="polite"
      data-averages={JSON.stringify(averages)}
    >
      <div class="totem-label" id="totem-label">
        {averageLabel(FUEL_UI_LABELS[initialFuel], initialAverage.self != null)}
      </div>
      <div class="totem-row">
        <div class="totem-main" data-avg-main hidden={initialAverage.self == null}>
          <span class="totem-price" data-avg-self>
            {initialAverage.self != null ? formatAverage(initialAverage.self) : ''}
          </span>
          <span class="totem-unit">€/L</span>
        </div>
        <p class="totem-empty" data-avg-empty hidden={initialAverage.self != null}>
          {SELF_UNAVAILABLE}
        </p>
        <div class="totem-served" data-avg-served-box hidden={initialAverage.served == null}>
          <span class="totem-served-label">servito</span>
          <span class="totem-served-price" data-avg-served>
            {initialAverage.served != null ? formatAverage(initialAverage.served) : ''}
          </span>
        </div>
      </div>
    </section>
    </div>

    <!-- 5. Mappa -->
    <div class="home-map">
      <MapView initialFuel={initialFuel} />
    </div>

    <div class="home-tools">
      <a class="home-tool" href={`${baseUrl}/calcola-risparmio`}>
        <span class="home-tool-icon" aria-hidden="true">⛽</span>
        <span class="home-tool-text">
          <strong>Dove conviene fare rifornimento</strong>
          <small>Scopri se vale la pena andare più lontano</small>
        </span>
        <span class="home-tool-arrow" aria-hidden="true">→</span>
      </a>
      <a class="home-tool" href={`${baseUrl}/andamento-prezzi`}>
        <span class="home-tool-icon" aria-hidden="true">📈</span>
        <span class="home-tool-text">
          <strong>Andamento dei prezzi</strong>
          <small>Come cambiano benzina, diesel e gli altri</small>
        </span>
        <span class="home-tool-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Alternativa testuale alla mappa (accessibilità, Milestone 9) -->
    <p class="sr-only">
      La mappa mostra i distributori con i relativi prezzi. In alternativa,
      usa la ricerca per località per vedere l'elenco dei distributori.
    </p>
   </div>
  </main>



  <section class="site-footer" aria-labelledby="region-links-title">
    <nav class="region-links" aria-labelledby="region-links-title">
      <h2 class="region-links-title" id="region-links-title">Prezzi carburante per regione</h2>
      <ul>
        {
          regions.map((r) => (
            <li>
              <a href={`${baseUrl}/prezzi-carburante/${r.slug}`}>{r.name}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="source-note">
      Fonte: Ministero delle Imprese e del Made in Italy (Osservaprezzi
      Carburanti). Aggiorniamo ogni mattina dalla rilevazione ministeriale; il
      prezzo di ciascun distributore risale all'ultima comunicazione del
      gestore.{extractionDate && ` Ultimo dato: ${extractionDate}.`}
    </p>
    <p class={`freshness freshness-${freshnessStatus}`} role="status">
      {freshnessLabel(freshnessStatus)}{
        freshnessStatus !== 'fresh' &&
          ': i prezzi mostrati potrebbero non essere aggiornati.'
      }
    </p>
  </section>
</Base>

<style>
  .freshness {
    margin-top: var(--space-2);
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .freshness-delayed,
  .freshness-stale,
  .freshness-unknown {
    font-weight: 600;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
  }
  .freshness-delayed {
    color: #7a4d06;
    background: #fdf1dc;
  }
  .freshness-stale,
  .freshness-unknown {
    color: #7a2318;
    background: #fbe3df;
  }
  .hero {
    background: var(--brand);
    padding: var(--space-5) var(--space-5) var(--space-6);
  }
  .hero-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .brand-mark {
    /* Simbolo ufficiale (asset light, pompa teal): non ridisegnato né ritagliato.
       Sul fondo teal dell'header il teal su teal darebbe 1,06:1, quindi il
       simbolo poggia su un badge chiaro: contrasto 4,89:1 e logo standard
       riconoscibile, senza introdurre una versione alternativa del marchio. */
    width: clamp(30px, 28px + 0.6vw, 40px);
    height: auto;
    display: block;
    box-sizing: content-box;
    padding: 5px;
    background: var(--surface);
    border-radius: 10px;
  }
  .brand-name {
    /* la dimensione cresce con la viewport, senza breakpoint dedicati */
    font-size: clamp(1.0625rem, 0.9rem + 0.9vw, 1.6rem);
  }
  /* Su mobile la navigazione dell'header sarebbe di troppo: i due strumenti
     restano raggiungibili dalle schede più in basso nella pagina. */
  .hero-nav {
    display: none;
  }
  .hero h1 {
    font-size: var(--fs-hero);
    color: var(--bg);
    margin-bottom: var(--space-1);
  }
  .tagline {
    font-size: var(--fs-sm);
    color: var(--brand-ink);
    margin: 0;
  }

  .container {
    padding: var(--space-4) var(--space-4) 0;
  }
  /* Mobile e tablet stretto: una colonna, ordine invariato. */
  .home-grid {
    display: block;
  }
  /* Quando la mappa viene portata in vista resta un filo di respiro sopra. */
  .home-map {
    scroll-margin-top: var(--space-3);
  }
  .home-map :global(.map-wrap) {
    scroll-margin-top: var(--space-3);
  }
  .home-tools {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: var(--space-4) 0;
  }
  .home-tool {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: border-color 0.15s;
  }
  .home-tool:hover {
    border-color: var(--accent);
  }
  .home-tool-icon {
    font-size: 24px;
    flex: 0 0 auto;
  }
  .home-tool-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .home-tool-text strong {
    font-size: var(--fs-base);
    font-weight: 600;
  }
  .home-tool-text small {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .home-tool-arrow {
    color: var(--accent);
    font-size: 18px;
    flex: 0 0 auto;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    margin-bottom: var(--space-2);
  }
  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    font-size: 18px;
  }
  .search input {
    width: 100%;
    padding: 11px 12px 11px 36px;
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-body);
    font-size: var(--fs-base);
  }

  /* --- Posizione: la prima azione. Piena su mobile, dove è la scorciatoia
     principale; su desktop diventa contornata (vedi media query). */
  .locate-cta {
    width: 100%;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 16px;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent);
    color: #fff; /* 6,52:1 su #066A63 */
    font-family: var(--font-body);
    font-size: var(--fs-base);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .locate-cta:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }
  .locate-cta[aria-busy='true'] {
    cursor: progress;
    opacity: 0.85;
  }
  .locate-icon {
    flex: 0 0 auto;
  }
  /* Messaggio discreto: nessun alert, nessun blocco. Vuoto non occupa spazio
     ma resta nel DOM, così gli screen reader annunciano i cambi. */
  .locate-status {
    margin: 6px 2px 0;
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: 1.4;
  }
  .locate-status:empty {
    margin: 0;
  }

  .or-sep {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: var(--space-2) 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
    text-transform: lowercase;
  }
  .or-sep::before,
  .or-sep::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .control-label {
    margin: var(--space-4) 0 6px;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Carburanti: griglia che va a capo, mai scorrimento orizzontale. Le
     colonne hanno larghezza minima sufficiente per l'etichetta più lunga
     ("Benzina+"), quindi il numero per riga si adatta allo spazio:
     4 + 3 su telefono e nella colonna desktop, una riga sola sul tablet. */
  .fuels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(74px, 1fr));
    gap: 6px;
    margin-bottom: var(--space-3);
  }
  .fuel-chip {
    min-width: 0;
    min-height: 40px;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-sm);
    white-space: nowrap;
    cursor: pointer;
  }
  .fuel-chip:hover {
    border-color: var(--accent);
  }
  .fuel-chip.active {
    background: var(--brand);
    color: var(--bg);
    border-color: var(--brand);
    font-weight: 500;
  }

  /* Superficie bianca con bordo leggero: la card risalta per gerarchia
     tipografica, non perché è un blocco colorato. */
  .totem {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 12px 16px;
    margin: var(--space-3) 0 var(--space-4);
  }
  /* `hidden` deve vincere sul display:flex delle parti del riquadro. */
  .totem [hidden] {
    display: none;
  }
  .totem-empty {
    margin: 4px 0;
    font-size: var(--fs-base);
    font-weight: 600;
    color: var(--text-muted);
  }
  .totem-label {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  .totem-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 5px;
  }
  .totem-main {
    display: flex;
    align-items: baseline;
    gap: 5px;
  }
  .totem-price {
    font-family: var(--font-mono);
    font-size: var(--fs-price);
    font-weight: 700;
    color: var(--brand-primary-dark); /* 10,12:1 su bianco */
    letter-spacing: -1px;
  }
  .totem-unit {
    font-size: var(--fs-sm);
    color: var(--text-secondary);
  }
  .totem-served {
    display: flex;
    align-items: baseline;
    gap: 5px;
    padding-left: 10px;
    border-left: 1px solid var(--border);
  }
  .totem-served-label {
    font-size: var(--fs-xs);
    color: var(--text-secondary);
  }
  .totem-served-price {
    font-family: var(--font-mono);
    font-size: var(--fs-lg);
    color: var(--text-primary);
  }

  .site-footer {
    padding: var(--space-5) var(--space-4) var(--space-6);
  }
  .region-links {
    margin-bottom: var(--space-5);
  }
  .region-links-title {
    font-size: var(--fs-base);
    font-weight: 600;
    margin-bottom: var(--space-3);
    color: var(--text);
  }
  .region-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }
  .region-links a {
    display: block;
    padding: 8px 12px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .region-links a:hover {
    background: var(--surface-alt);
  }
  @media (min-width: 640px) {
    .region-links ul {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }
  /* Banner informativo, non un cookie banner: nessun consenso da raccogliere,
     nessuno stato da ricordare, nessun elemento che copra la pagina. */
  .privacy-note {
    margin: var(--space-6) 0 0;
    background: var(--surface-alt);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .privacy-note-inner {
    max-width: 1600px;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
  }
  .privacy-note h2 {
    font-size: var(--fs-base);
    margin: 0 0 var(--space-1);
    color: var(--text);
  }
  .privacy-note p {
    margin: 0 0 var(--space-3);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    max-width: 60ch;
  }
  .privacy-note-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  .privacy-note-links a {
    color: var(--accent-hover);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .privacy-note-links a:hover,
  .privacy-note-links a:focus-visible {
    text-decoration: underline;
  }

  .source-note {
    font-size: 10px;
    line-height: 1.55;
    color: var(--text-faint);
    margin: 0;
  }
  .footer-tools {
    margin: 0 0 var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .footer-tools a {
    color: var(--accent);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  /* ---------------------------------------------------------------- mobile
     Sotto i 768 px la mappa deve comparire il prima possibile: header ridotto
     a una striscia con logo e wordmark, controlli più compatti. Stesso ordine,
     stessi elementi, nessuna logica toccata; tablet e desktop invariati. */
  @media (max-width: 767.98px) {
    .hero {
      padding: 8px var(--space-4);
    }
    .hero-bar {
      margin-bottom: 0;
    }
    .brand-mark {
      width: 28px;
      padding: 4px;
      border-radius: 8px;
    }
    /* :global perché il wordmark è un componente a sé: la sola classe
       .brand-name, con lo scope della pagina, non lo raggiunge. */
    .brand :global(.brand-name) {
      font-size: 1.25rem;
    }
    /* Titolo e numero di distributori escono dalla striscia ma restano nel
       DOM: l'h1 continua a esistere per screen reader e motori di ricerca, e
       il conteggio resta quello calcolato in build. */
    .hero-text {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .container {
      padding-top: var(--space-3);
    }
    .locate-cta {
      min-height: 44px;
      padding: 9px 14px;
    }
    .locate-status {
      margin-top: 4px;
    }
    .or-sep {
      margin: 4px 0;
    }
    .search {
      margin-bottom: 0;
    }
    .search input {
      padding-top: 10px;
      padding-bottom: 10px;
    }
    .control-label {
      margin: 10px 0 5px;
    }
    .fuels {
      gap: 5px;
      margin-bottom: var(--space-2);
    }
    .fuel-chip {
      min-height: 40px;
      padding: 4px 6px;
    }
    .filters-trigger {
      min-height: 40px;
      padding: 6px 12px;
    }
    .totem {
      padding: 8px 12px;
      margin: var(--space-2) 0 var(--space-3);
    }
    .totem-row {
      margin-top: 2px;
    }
    .totem-price {
      font-size: 1.75rem;
    }
  }

  /* ---------------------------------------------------------------- tablet
     768–1023 px: resta una colonna, ma più larga e con l'header su una riga
     sola. Due colonne qui comprimerebbero troppo la mappa. */
  @media (min-width: 768px) {
    .container {
      max-width: 760px;
      margin: 0 auto;
    }
    .hero-inner,
    .hero {
      text-align: left;
    }
    .home-tools {
      flex-direction: row;
    }
    .home-tool {
      flex: 1;
    }
  }

  /* --------------------------------------------------------------- desktop
     Da 1024 px il layout diventa orizzontale: i controlli si raccolgono in una
     colonna stretta a sinistra e la mappa occupa tutto lo spazio rimanente.
     È il cambio che trasforma la pagina da "mobile allargato" a strumento. */
  @media (min-width: 1024px) {
    .hero {
      padding: var(--space-4) var(--space-6);
    }
    .hero-bar {
      max-width: 1600px;
      margin: 0 auto var(--space-3);
    }
    .hero-nav {
      display: flex;
      gap: var(--space-5);
    }
    .hero-nav a {
      color: var(--brand-ink);
      text-decoration: none;
      font-size: var(--fs-sm);
      font-weight: 500;
      padding: var(--space-2) 0;
    }
    .hero-nav a:hover,
    .hero-nav a:focus-visible {
      color: var(--bg);
    }
    .hero-text {
      max-width: 1600px;
      margin: 0 auto;
    }
    .hero h1 {
      /* La scala tipografica di base è pensata per il telefono: qui la
         lasciamo crescere, altrimenti a 1440px il titolo resta a 22px. */
      font-size: clamp(1.375rem, 0.9rem + 1.6vw, 2.25rem);
    }
    .tagline {
      font-size: var(--fs-base);
    }

    .container {
      max-width: 1600px;
      padding: var(--space-5) var(--space-6) 0;
    }

    /* Il DOM è mobile-first (controlli → mappa → strumenti). Qui la griglia
       riporta gli strumenti nella colonna di sinistra sotto i controlli, e
       lascia la mappa a destra su entrambe le righe. Nessuna duplicazione di
       markup: cambia solo la posizione assegnata dalle aree. */
    .home-grid {
      display: grid;
      grid-template-columns: minmax(320px, 380px) minmax(0, 1fr);
      grid-template-areas:
        'controlli mappa'
        'strumenti mappa';
      grid-template-rows: auto 1fr;
      gap: var(--space-4) var(--space-6);
      align-items: start;
    }
    .home-controls {
      grid-area: controlli;
    }
    /* Nella colonna desktop sempre 4 + 3: con auto-fit a 1440 px sarebbero
       5 + 2, una seconda riga sbilanciata. */
    .fuels {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    /* Su desktop la posizione resta la prima voce ma pesa meno: contornata,
       così non compete con la mappa che sta accanto. */
    .locate-cta {
      min-height: 44px;
      background: var(--surface);
      color: var(--accent);
      font-size: var(--fs-sm);
    }
    .locate-cta:hover {
      background: var(--accent);
      color: #fff;
    }
    .home-tools {
      grid-area: strumenti;
    }
    .home-map {
      grid-area: mappa;
      /* Altezza utile ma prudente sui laptop bassi: mai oltre la viewport. */
      height: clamp(520px, calc(100vh - 230px), 820px);
    }
    .home-map :global(.map-wrap),
    .home-map :global(#map) {
      height: 100%;
    }

    /* Nel pannello gli strumenti tornano in colonna: lo spazio è verticale. */
    .home-tools {
      flex-direction: column;
    }

    /* I link regione respirano su più colonne invece di incolonnarsi. */
    .region-links :global(ul),
    .region-list {
      columns: 3;
      column-gap: var(--space-6);
    }
  }

  @media (min-width: 1440px) {
    .home-grid {
      grid-template-columns: minmax(360px, 420px) minmax(0, 1fr);
    }
  }
</style>

<script>
  import { initSearch } from '../lib/search/client.ts';
  import { initFilters } from '../lib/filters/client.ts';
  import { FUEL_UI_LABELS } from '../lib/data/fuels-ui.ts';
  import {
    averageFor,
    averageLabel,
    formatAverage,
    type AverageTable,
  } from '../lib/data/nationalAverage.ts';
  import type { Station, FuelKey } from '../types/pieno.ts';

  // Hook esposti dalla mappa (lib/map/client.ts) quando è pronta.
  const w = window as unknown as {
    __pienoFlyTo?: (lat: number, lng: number, zoom: number) => void;
    __pienoGetStations?: () => Station[];
    __pienoApplyFilter?: (pred: (s: Station) => boolean) => void;
    __pienoSetFuel?: (f: FuelKey) => void;
    __pienoMapReady?: boolean;
  };

  const mapWrap = document.querySelector<HTMLElement>('.map-wrap');
  const mapInitialFuel = (mapWrap?.dataset.fuel ?? 'benzina') as FuelKey;

  // Carburante corrente (letto dai chip): unica fonte per pagina e mappa.
  function currentFuel(): FuelKey {
    const active = document.querySelector('.fuel-chip.active');
    return (active?.getAttribute('data-fuel') ?? mapInitialFuel) as FuelKey;
  }

  // ---------------------------------------------------- media nazionale
  // I valori arrivano da meta.stats, serializzati in build nel riquadro. Se un
  // carburante non ha una media self valida si mostra "Dato self non
  // disponibile" (il servito, se c'è, resta etichettato come tale): mai
  // il valore di un altro carburante.
  const totem = document.getElementById('national-average');
  let averages: AverageTable = {};
  try {
    averages = JSON.parse(totem?.dataset.averages ?? '{}') as AverageTable;
  } catch {
    averages = {};
  }

  function renderAverage(fuel: FuelKey): void {
    if (!totem) return;
    const avg = averageFor(averages, fuel);
    const q = <T extends HTMLElement>(sel: string) => totem.querySelector<T>(sel);
    const label = q('#totem-label');
    if (label) label.textContent = averageLabel(FUEL_UI_LABELS[fuel], avg.self != null);

    const main = q('[data-avg-main]');
    const empty = q('[data-avg-empty]');
    const self = q('[data-avg-self]');
    if (self) self.textContent = avg.self != null ? formatAverage(avg.self) : '';
    if (main) main.hidden = avg.self == null;
    if (empty) empty.hidden = avg.self != null;

    const servedBox = q('[data-avg-served-box]');
    const served = q('[data-avg-served]');
    if (served) served.textContent = avg.served != null ? formatAverage(avg.served) : '';
    if (servedBox) servedBox.hidden = avg.served == null;
  }

  // ---------------------------------------------------- cambio carburante
  // Chip, media nazionale e mappa si aggiornano nello stesso click. Se la mappa
  // non è ancora pronta, il carburante scelto le viene passato appena lo è.
  const chips = document.querySelectorAll<HTMLElement>('.fuel-chip');
  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      chips.forEach((c) => {
        c.classList.remove('active');
        c.setAttribute('aria-selected', 'false');
      });
      chip.classList.add('active');
      chip.setAttribute('aria-selected', 'true');
      const fuel = currentFuel();
      renderAverage(fuel);
      if (w.__pienoSetFuel) w.__pienoSetFuel(fuel);
    });
  });
  renderAverage(currentFuel());

  // ---------------------------------------------------- spostare la mappa
  // Ricerca e posizione funzionano anche prima che la mappa sia pronta: lo
  // spostamento richiesto viene applicato appena la mappa esiste.
  let pendingFly: [number, number, number] | null = null;

  function revealMap(): void {
    // Su telefono la mappa sta sotto i controlli: se è quasi tutta fuori
    // schermo la portiamo in vista, altrimenti l'utente non vede il risultato.
    const el = document.querySelector<HTMLElement>('.map-wrap');
    if (!el) return;
    const r = el.getBoundingClientRect();
    const visible = Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0);
    if (visible >= Math.min(r.height, window.innerHeight) / 2) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    el.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }

  function flyTo(lat: number, lng: number, zoom: number): void {
    if (w.__pienoFlyTo) w.__pienoFlyTo(lat, lng, zoom);
    else pendingFly = [lat, lng, zoom];
    revealMap();
  }

  // ---------------------------------------------------- posizione
  // Il permesso viene chiesto SOLO qui, al click. Nessun alert: in caso di
  // rifiuto o errore compare un messaggio discreto e la ricerca resta lì sotto.
  const locateBtn = document.getElementById('locate');
  const locateStatus = document.getElementById('locate-status');
  const LOCATE_FAILED = 'Posizione non disponibile. Cerca una località.';
  let locating = false;
  let locateGuard: ReturnType<typeof setTimeout> | undefined;

  function setLocateStatus(msg: string): void {
    if (locateStatus) locateStatus.textContent = msg;
  }
  function endLocate(): void {
    locating = false;
    clearTimeout(locateGuard);
    locateBtn?.removeAttribute('aria-busy');
  }

  locateBtn?.addEventListener('click', () => {
    if (locating) return;
    if (!('geolocation' in navigator)) {
      setLocateStatus(LOCATE_FAILED);
      return;
    }
    locating = true;
    locateBtn.setAttribute('aria-busy', 'true');
    setLocateStatus('Sto cercando la tua posizione…');
    // Il timeout dell'API non conta il tempo in cui il prompt del permesso
    // resta senza risposta: se l'utente lo ignora, dopo 20 s diciamo comunque
    // che può cercare a mano. Se la posizione arriva dopo, la usiamo lo stesso.
    locateGuard = setTimeout(() => {
      endLocate();
      setLocateStatus(LOCATE_FAILED);
    }, 20_000);
    navigator.geolocation.getCurrentPosition(
      (pos) => {
        endLocate();
        setLocateStatus('Mappa centrata sulla tua posizione.');
        flyTo(pos.coords.latitude, pos.coords.longitude, 13);
      },
      () => {
        endLocate();
        setLocateStatus(LOCATE_FAILED);
      },
      // Senza timeout alcuni browser restano in attesa per sempre quando la
      // localizzazione del dispositivo è spenta.
      { timeout: 15_000, maximumAge: 60_000 },
    );
  });

  // ---------------------------------------------------- ricerca
  // Serve solo l'indice dei comuni: si attiva subito, senza aspettare la mappa.
  const base = mapWrap?.dataset.dataUrl ?? '';
  const indexUrl = base.replace('stations.json', 'search-index.json');
  initSearch({ flyTo, indexUrl });

  // ---------------------------------------------------- filtri e mappa pronta
  // I filtri hanno bisogno delle stazioni caricate dalla mappa (il dataset
  // nazionale pesa alcuni MB). Nessun timeout: la mappa emette
  // "pieno:map-ready" quando gli hook sono pronti, per quanto tempo serva.
  let mapReadyHandled = false;
  function onMapReady(): void {
    if (mapReadyHandled) return; // initFilters una volta sola
    mapReadyHandled = true;
    initFilters({
      getStations: () => w.__pienoGetStations!(),
      applyFilter: (pred) => w.__pienoApplyFilter!(pred),
      getFuel: currentFuel,
      fuelLabel: (f) => FUEL_UI_LABELS[f],
    });
    // Carburante scelto prima che la mappa fosse pronta.
    if (currentFuel() !== mapInitialFuel && w.__pienoSetFuel) w.__pienoSetFuel(currentFuel());
    if (pendingFly) {
      const [lat, lng, zoom] = pendingFly;
      pendingFly = null;
      w.__pienoFlyTo!(lat, lng, zoom);
    }
  }

  // Se la mappa è già pronta quando arriviamo, inizializziamo subito;
  // altrimenti aspettiamo il segnale.
  if (w.__pienoMapReady) onMapReady();
  else window.addEventListener('pieno:map-ready', onMapReady, { once: true });
</script>
