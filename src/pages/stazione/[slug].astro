---
/**
 * Pagina singola stazione: /stazione/[slug]  (slug = id-nome)
 * L'ID ufficiale MIMIT è la parte identificativa (URL permanente).
 * Mostra: prezzi self/servito per carburante, confronto locale (mediana 5km),
 * risparmio su 20/40/60L, alternative vicine, mappa interattiva, naviga/condividi.
 */
import Base from '../../layouts/Base.astro';
import MiniMap from '../../components/territory/MiniMap.astro';
import { getSpatialIndex } from '../../lib/geo/loadSpatial.ts';
import { buildStationPage, stationSlug } from '../../lib/geo/stationPage.ts';
import { formatPrice, FUEL_UI_LABELS } from '../../lib/data/load.ts';
import { breadcrumbLd } from '../../lib/seo/breadcrumb.ts';
import { BASE, HOME } from '../../lib/site.ts';

export function getStaticPaths() {
  const { stations, index } = getSpatialIndex();
  return stations.map((station) => ({
    params: { slug: stationSlug(station) },
    props: { data: buildStationPage(station, index) },
  }));
}

const { data } = Astro.props;
const s = data.station;
const base = BASE;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';

const classLabels: Record<string, string> = {
  molto_conveniente: 'Molto conveniente',
  conveniente: 'Conveniente',
  nella_media: 'Nella media',
  caro: 'Caro',
  molto_caro: 'Molto caro',
  dati_insufficienti: 'Dati insufficienti in zona',
};
const classColor: Record<string, string> = {
  molto_conveniente: 'var(--price-good)',
  conveniente: 'var(--price-good)',
  nella_media: 'var(--price-mid)',
  caro: 'var(--price-bad)',
  molto_caro: 'var(--price-bad)',
  dati_insufficienti: 'var(--text-faint)',
};

const navUrl = `https://www.google.com/maps/dir/?api=1&destination=${s.lat},${s.lng}`;
const ld = breadcrumbLd([
  { name: 'Home', url: `${site}${HOME}` },
  { name: s.comune, url: `${site}${HOME}` },
  { name: s.name, url: `${site}${base}/stazione/${stationSlug(s)}` },
]);
---

<Base
  title={`${s.brand} ${s.name} a ${s.comune} — prezzi carburante | Pieno`}
  description={`Prezzi aggiornati di ${s.brand} ${s.name} a ${s.comune} (${s.provincia}): benzina, diesel e altri carburanti, confronto con la zona e risparmio stimato.`}
  canonicalPath={`/stazione/${stationSlug(s)}`}
  structuredData={ld}
>
  <nav class="breadcrumb" aria-label="Percorso">
    <a href={HOME}>Home</a>
    <span aria-hidden="true">›</span>
    {
      data.regionSlug && (
        <>
          <a href={`${base}/prezzi-carburante/${data.regionSlug}`}>{data.region}</a>
          <span aria-hidden="true">›</span>
        </>
      )
    }
    <span>{s.comune}</span>
  </nav>

  <main class="station" id="contenuto">
    <header class="station-head">
      <span class="station-brand">{s.brand}</span>
      <h1>{s.name}</h1>
      <p class="station-loc">
        {s.comune} ({s.provincia}){data.region && `, ${data.region}`}
      </p>
    </header>

    <div class="station-actions">
      <a class="btn-primary" href={navUrl} target="_blank" rel="noopener">
        ➤ Avvia navigazione
      </a>
      <button class="btn-secondary" id="share-btn" type="button">Condividi</button>
    </div>

    <MiniMap lat={s.lat} lng={s.lng} label={`${s.brand} ${s.name}`} zoom={14} radiusKm={5} />

    <section>
      <h2 class="section-title">Prezzi e confronto con la zona</h2>
      <div class="fuel-cards">
        {
          data.fuels.map((f) => (
            <div class="fuel-card">
              <div class="fuel-card-head">
                <span class="fuel-card-name">{FUEL_UI_LABELS[f.fuel]}</span>
                {f.comparison && (
                  <span
                    class="fuel-card-badge"
                    style={`background:${classColor[f.comparison.class]}`}
                  >
                    {classLabels[f.comparison.class]}
                  </span>
                )}
              </div>
              <div class="fuel-card-prices">
                {f.self != null && (
                  <div class="fuel-price">
                    <span class="fuel-price-num">{formatPrice(f.self)}</span>
                    <span class="fuel-price-lab">self €/L</span>
                  </div>
                )}
                {f.served != null && (
                  <div class="fuel-price">
                    <span class="fuel-price-num">{formatPrice(f.served)}</span>
                    <span class="fuel-price-lab">servito €/L</span>
                  </div>
                )}
              </div>
              {f.comparison?.localMedian != null && f.comparison.deltaCents != null && (
                <p class="fuel-card-cmp">
                  {f.comparison.deltaCents < 0
                    ? `${Math.abs(f.comparison.deltaCents)}¢ sotto`
                    : f.comparison.deltaCents > 0
                      ? `${f.comparison.deltaCents}¢ sopra`
                      : 'in linea con'}{' '}
                  la mediana entro 5 km ({f.comparison.sampleSize} distributori)
                </p>
              )}
              {f.savings.length > 0 && f.savings[0].amount > 0 && (
                <p class="fuel-card-save">
                  Risparmio vs media zona:{' '}
                  {f.savings.map((sv, i) => (
                    <>
                      {i > 0 && ' · '}
                      <strong>{sv.amount.toFixed(2)}€</strong>/{sv.liters}L
                    </>
                  ))}
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {
      Object.keys(data.alternatives).length > 0 && (
        <section>
          <h2 class="section-title">Alternative più economiche vicine</h2>
          {Object.entries(data.alternatives).map(([fuel, alts]) => (
            <div class="alt-group">
              <div class="alt-fuel">{FUEL_UI_LABELS[fuel as keyof typeof FUEL_UI_LABELS]}</div>
              <ul class="alt-list">
                {alts!.map((a) => (
                  <li>
                    <a href={`${base}/stazione/${a.slug}`}>
                      {a.brand} · {a.name}
                    </a>
                    <span class="alt-meta">
                      {a.distanceKm} km · <strong>{formatPrice(a.price)} €/L</strong>
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    <p class="station-source">
      Prezzi comunicati dal gestore al Ministero (Osservaprezzi Carburanti). Il
      confronto locale usa la mediana dei distributori entro 5 km.
    </p>
  </main>
</Base>

<style>
  .breadcrumb {
    padding: var(--space-3) var(--space-4);
    font-size: var(--fs-sm);
    color: var(--text-muted);
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
  }
  .breadcrumb a {
    color: var(--accent);
    text-decoration: none;
  }
  .station {
    padding: 0 var(--space-4) var(--space-6);
    max-width: 720px;
    margin: 0 auto;
  }
  .station-brand {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    font-weight: 600;
  }
  .station-head h1 {
    font-size: var(--fs-hero);
    margin: 2px 0;
  }
  .station-loc {
    color: var(--text-muted);
    font-size: var(--fs-sm);
    margin: 0 0 var(--space-4);
  }
  .station-actions {
    display: flex;
    gap: 8px;
    margin-bottom: var(--space-4);
  }
  .btn-primary,
  .btn-secondary {
    flex: 1;
    text-align: center;
    padding: 12px;
    border-radius: var(--radius);
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    border: none;
    font-family: var(--font-body);
  }
  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .btn-secondary {
    background: var(--surface);
    color: var(--text);
    border: 0.5px solid var(--border);
  }
  .section-title {
    font-size: var(--fs-lg);
    margin: var(--space-5) 0 var(--space-3);
  }
  .fuel-cards {
    display: grid;
    gap: 10px;
  }
  .fuel-card {
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 14px 16px;
  }
  .fuel-card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }
  .fuel-card-name {
    font-weight: 600;
    font-family: var(--font-display);
  }
  .fuel-card-badge {
    font-size: var(--fs-xs);
    color: #fff;
    padding: 3px 10px;
    border-radius: 20px;
    font-weight: 500;
  }
  .fuel-card-prices {
    display: flex;
    gap: 20px;
  }
  .fuel-price {
    display: flex;
    flex-direction: column;
  }
  .fuel-price-num {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text);
  }
  .fuel-price-lab {
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }
  .fuel-card-cmp {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    margin: 8px 0 0;
  }
  .fuel-card-save {
    font-size: var(--fs-sm);
    color: var(--accent);
    margin: 6px 0 0;
  }
  .alt-group {
    margin-bottom: var(--space-3);
  }
  .alt-fuel {
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--text-muted);
    margin-bottom: 6px;
  }
  .alt-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .alt-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    background: var(--surface);
    border: 0.5px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 6px;
  }
  .alt-list a {
    color: var(--text);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .alt-meta {
    font-size: var(--fs-xs);
    color: var(--text-muted);
    white-space: nowrap;
  }
  .station-source {
    font-size: 10px;
    color: var(--text-faint);
    margin-top: var(--space-5);
  }
</style>

<script>
  const btn = document.getElementById('share-btn');
  btn?.addEventListener('click', async () => {
    const url = window.location.href;
    const title = document.title;
    if (navigator.share) {
      try {
        await navigator.share({ title, url });
      } catch {
        /* annullato */
      }
    } else {
      await navigator.clipboard.writeText(url);
      btn.textContent = 'Link copiato!';
      setTimeout(() => (btn.textContent = 'Condividi'), 2000);
    }
  });
</script>
