---
/**
 * Layout base di benzaGo.
 * Gestisce <head>, SEO, font, service worker e wrappa il contenuto.
 *
 * Modifiche di questo sprint:
 *  - canonical e Open Graph passano dagli helper centralizzati, così restano
 *    corretti sia con BASE_PATH=/pieno-dati/ sia con BASE_PATH=/;
 *  - aggiunta una vera social preview image (1200x630);
 *  - font self-hosted: niente più richiesta bloccante a fonts.googleapis.com;
 *  - skip link per la navigazione da tastiera;
 *  - il service worker segnala una versione nuova e la pagina la applica.
 */
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/archivo/latin-500.css';
import '@fontsource/archivo/latin-600.css';
import '@fontsource/space-mono/latin-400.css';
import '@fontsource/space-mono/latin-700.css';
import '../styles/tokens.css';
import { withBase } from '../lib/site.ts';

export interface Props {
  title: string;
  description: string;
  /** Path canonico relativo (es. "/calcola-risparmio"). Default: home. */
  canonicalPath?: string;
  /** Dati strutturati JSON-LD (oggetto o array), inseriti nel <head>. */
  structuredData?: object | object[];
  /** Esclude la pagina dall'indice (404, pagine di servizio). */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = '',
  structuredData,
  noindex = false,
} = Astro.props;

const origin = (Astro.site?.origin ?? '').replace(/\/+$/, '');
const canonical = `${origin}${withBase(canonicalPath)}`;
const ogImage = `${origin}${withBase('/og/og-default.png')}`;
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="benzaGo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="benzaGo — prezzi carburante in tutta Italia, dati ufficiali MIMIT"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#12303a" />

    <!-- Favicon -->
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon-32.png')} sizes="32x32" type="image/png" />

    <!-- PWA -->
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/apple-touch-icon.png')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="benzaGo" />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <slot />

    <footer class="site-legal">
      <div class="site-legal-inner">
        <nav class="site-legal-links" aria-label="Informazioni legali">
          <a href={withBase('/privacy')}>Privacy</a>
          <a href={withBase('/cookie-e-tecnologie')}>Cookie e tecnologie</a>
          <a href={withBase('/note-legali')}>Note legali</a>
        </nav>
        <p class="site-legal-credits">
          Dati carburanti: MIMIT — Osservatorio Prezzi Carburanti, licenza
          <a
            href="https://www.dati.gov.it/content/italian-open-data-license-v20"
            target="_blank"
            rel="noopener">IODL 2.0</a>, rielaborati da benzaGo. Servizio
          indipendente, non affiliato al MIMIT. I prezzi non sono in tempo
          reale: fa fede quello esposto all'impianto.
        </p>
        <p class="site-legal-credits">
          Mappa: ©
          <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener">OpenStreetMap</a> contributors
        </p>
      </div>
    </footer>

    <style>
      .site-legal {
        border-top: 1px solid var(--border, #d8d3c8);
        margin-top: var(--space-6, 1.5rem);
        font-size: var(--fs-xs, 0.7rem);
        color: var(--text-muted, #6b7b7f);
        line-height: 1.6;
      }
      .site-legal-inner {
        max-width: 1600px;
        margin: 0 auto;
        padding: var(--space-5, 1.25rem) var(--space-4, 1rem) var(--space-6, 1.5rem);
      }
      .site-legal-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-5, 1.25rem);
        margin-bottom: var(--space-3, 0.75rem);
      }
      .site-legal-links a {
        color: var(--brand, #12303a);
        font-weight: 500;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
      }
      .site-legal-credits {
        margin: 0 0 var(--space-2, 0.5rem);
        max-width: 70ch;
      }
      @media (min-width: 1024px) {
        .site-legal-inner {
          padding-inline: var(--space-6, 1.5rem);
        }
      }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 1000;
        padding: 0.75rem 1rem;
        background: var(--c-ink, #12303a);
        color: #fff;
        border-radius: 0 0 8px 0;
      }
      .skip-link:focus {
        left: 0;
      }
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>

    <script>
      import { withBase } from '../lib/site.ts';

      // Registrazione del service worker.
      //
      // Nessun banner e nessun ricaricamento forzato: online l'HTML arriva
      // sempre dalla rete (strategia network-first), quindi ogni pagina che
      // l'utente apre è già l'ultima versione, con i suoi asset nuovi. Il
      // service worker aggiornato si attiva in silenzio e serve solo da rete
      // di sicurezza quando la connessione manca.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(withBase('/sw.js')).catch(() => {
            // Il sito funziona anche senza service worker: nessun avviso.
          });
        });
      }
    </script>
  </body>
</html>
